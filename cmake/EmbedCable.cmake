# Pin the complete unmodified vendor distribution; no network at build time.
set(cable_archive "${CMAKE_CURRENT_SOURCE_DIR}/downloads/VBCABLE_Driver_Pack45.zip")
file(SHA256 "${cable_archive}" cable_sha)
if(NOT cable_sha STREQUAL "b950e39f01af1d04ea623c8f6d8eb9b6ea5c477c637295fabf20631c85116bfb")
  message(FATAL_ERROR "Unexpected VB-CABLE package. Review the vendor release before updating the pin.")
endif()
set(cable_dir "${CMAKE_CURRENT_BINARY_DIR}/embedded-vbcable")
file(MAKE_DIRECTORY "${cable_dir}")
file(ARCHIVE_EXTRACT INPUT "${cable_archive}" DESTINATION "${cable_dir}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar tf "${cable_archive}"
  OUTPUT_VARIABLE cable_listing RESULT_VARIABLE cable_listing_result OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT cable_listing_result EQUAL 0)
  message(FATAL_ERROR "Cannot list VB-CABLE archive")
endif()
string(REPLACE "\r" "" cable_listing "${cable_listing}")
string(REPLACE "\n" ";" cable_files "${cable_listing}")
list(SORT cable_files)
set(cable_rc "")
set(cable_header "#pragma once\n#include <cstddef>\nnamespace cable_bundle {\nstruct Entry { int id; const wchar_t* name; unsigned long size; const char* sha256; };\ninline constexpr Entry entries[] = {\n")
set(cable_id 2000)
foreach(cable_file IN LISTS cable_files)
  if(NOT cable_file MATCHES "^[A-Za-z0-9_.-]+$")
    message(FATAL_ERROR "Unexpected VB-CABLE filename: ${cable_file}")
  endif()
  file(SIZE "${cable_dir}/${cable_file}" cable_size)
  file(SHA256 "${cable_dir}/${cable_file}" cable_file_sha)
  string(APPEND cable_rc "${cable_id} RCDATA \"${cable_dir}/${cable_file}\"\n")
  string(APPEND cable_header "{${cable_id}, L\"${cable_file}\", ${cable_size}, \"${cable_file_sha}\"},\n")
  math(EXPR cable_id "${cable_id}+1")
endforeach()
string(APPEND cable_header "};\n}\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/cable_bundle.rc" "${cable_rc}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/cable_bundle_manifest.hpp" "${cable_header}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${cable_archive}")
target_sources(PortableMixer PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/cable_bundle.rc")
target_include_directories(PortableMixer PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
