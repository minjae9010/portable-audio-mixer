[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/24/2026,0.3.0.0
CatalogFile=PortableMixerVirtualMic.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22621
[Models.NTamd64.10.0...22621]
%Device%=Install,PortableMixer\VirtualMicrophone

[SourceDisksNames]
1=%Device%,,,
[SourceDisksFiles]
PortableMixerVirtualMic.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
PortableMixerVirtualMic.sys

[Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=AudioReg
[AudioReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,PortableMixerVirtualMic.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Device%
HKR,Drivers\mixer\wdmaud.drv,Description,,%Device%
HKR,MediaCategories\{b3929cc4-8655-4e5e-bc2b-2f49a3185910},Name,,%Device%

[Install.NT.Services]
AddService=PortableMixerVirtualMic,0x00000002,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\PortableMixerVirtualMic.sys

[Install.NT.Wdf]
KmdfService=PortableMixerVirtualMic,Wdf
[Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Install.NT.HW]
AddReg=Hardware
[Hardware]
HKR,,DeviceType,0x10001,0x1d
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Install.NT.Interfaces]
AddInterface=%Audio%,WaveMicIn,Wave
AddInterface=%Realtime%,WaveMicIn,Wave
AddInterface=%Capture%,WaveMicIn,Wave
AddInterface=%Audio%,TopologyMicIn,Topology
AddInterface=%TopologyCategory%,TopologyMicIn,Topology
[Wave]
AddReg=WaveReg
[WaveReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Device%
[Topology]
AddReg=TopologyReg
[TopologyReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Device%
HKR,EP\0,"{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2",,"{00000000-0000-0000-0000-000000000000}"
HKR,EP\0,"{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7",0x10001,1

[Strings]
Provider="Portable Mixer Project"
Device="Portable Mixer Microphone"
